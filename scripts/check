#!/usr/bin/env python3
"""Check public membership, About descriptions, family adoption and GitHub settings."""

import argparse
from http.client import HTTPException
import json
import os
from pathlib import Path
import re
import sys
from urllib.parse import quote, urlsplit
from urllib.request import Request, urlopen


ROOT = Path(__file__).resolve().parents[1]
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT / "scripts"))
import family_settings


def read_catalog(root=ROOT):
    """Read the fields needed for membership; the profile workflow owns the schema."""
    catalog = json.loads((root / "profile/catalog.json").read_text(encoding="utf-8"))
    try:
        login = catalog["organization"]["login"]
        groups = catalog["groups"]
        if not isinstance(login, str) or not login or not isinstance(groups, list):
            raise ValueError("expected organization.login and groups")
        for group in groups:
            entries = group["repositories"]
            if not isinstance(entries, list):
                raise ValueError("expected group repositories")
            for entry in entries:
                if not isinstance(entry["name"], str) or not entry["name"]:
                    raise ValueError("expected repository name")
    except (KeyError, TypeError) as error:
        raise ValueError("cannot read catalog membership fields") from error
    return catalog


def fetch_repositories(organization, token=None, *, opener=urlopen):
    if token and any(character.isspace() or not character.isprintable() for character in token):
        raise ValueError("GITHUB_TOKEN must not contain whitespace or control characters")
    endpoint = f"https://api.github.com/orgs/{quote(organization, safe='')}/repos"
    url = endpoint + "?type=public&per_page=100"
    headers = {"Accept": "application/vnd.github+json", "User-Agent": "organization-profile-check"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    repositories = []
    visited = set()
    while url:
        if url in visited:
            raise ValueError("GitHub API pagination repeated a page")
        visited.add(url)
        try:
            with opener(Request(url, headers=headers), timeout=30) as response:
                page = json.load(response)
                links = response.headers.get("Link", "")
        except (HTTPException, OSError, ValueError):
            # Request exceptions can contain authorization headers.
            raise ValueError("could not read GitHub API: request or response failed") from None
        if not isinstance(page, list) or any(
            not isinstance(repository, dict)
            or not isinstance(repository.get("name"), str)
            or not repository["name"]
            or not isinstance(repository.get("archived"), bool)
            or not isinstance(repository.get("private"), bool)
            for repository in page
        ):
            raise ValueError("GitHub API returned an invalid repository list")
        repositories.extend(page)
        next_link = re.search(r'<([^>]+)>;\s*rel="next"', links)
        url = next_link.group(1) if next_link else None
        if url:
            parsed = urlsplit(url)
            if (parsed.scheme, parsed.netloc, parsed.path) != (
                "https", "api.github.com", urlsplit(endpoint).path
            ):
                raise ValueError("GitHub API pagination points outside the repository endpoint")
    return repositories


def compare_membership(catalog, repositories):
    expected = {
        repository["name"]
        for repository in repositories
        if not repository["private"] and not repository["archived"] and repository["name"] != ".github"
    }
    actual = {
        repository["name"]
        for group in catalog["groups"]
        for repository in group["repositories"]
    }
    differences = []
    if expected - actual:
        differences.append("missing from catalog: " + ", ".join(sorted(expected - actual)))
    if actual - expected:
        differences.append("extra in catalog: " + ", ".join(sorted(actual - expected)))
    if differences:
        raise ValueError("; ".join(differences))


def compare_about(catalog, repositories):
    live = {repository["name"]: repository for repository in repositories}
    entries = [(".github", catalog["organization"])] + [
        (entry["name"], entry) for group in catalog["groups"] for entry in group["repositories"]
    ]
    differences = []
    for name, entry in entries:
        if not isinstance(entry.get("about"), str) or not entry["about"]:
            differences.append(f"{name}: catalog about is missing or invalid")
        elif name not in live:
            differences.append(f"{name}: live repository is missing")
        elif "description" not in live[name]:
            differences.append(f"{name}: live description is unavailable")
        elif entry["about"] != live[name]["description"]:
            differences.append(f"{name}: catalog {entry['about']!r}; live {live[name]['description']!r}")
    if differences:
        raise ValueError("; ".join(differences))


def check_repositories(catalog, catalog_error, *, offline=False):
    if catalog is None:
        for label in ("repository membership", "repository about"):
            print(f"FAIL {label}: " + " ".join(str(catalog_error).splitlines()))
        return True
    if offline:
        print("SKIP repository membership (--offline)")
        print("SKIP repository about (--offline)")
        return False
    try:
        repositories = fetch_repositories(catalog["organization"]["login"], os.environ.get("GITHUB_TOKEN"))
    except (OSError, ValueError) as error:
        for label in ("repository membership", "repository about"):
            print(f"FAIL {label}: " + " ".join(str(error).splitlines()))
        return True
    failed = False
    for label, compare in (("repository membership", compare_membership),
                           ("repository about", compare_about)):
        try:
            compare(catalog, repositories)
            print(f"PASS {label}")
        except ValueError as error:
            print(f"FAIL {label}: " + " ".join(str(error).splitlines()))
            failed = True
    return failed


def main(argv=None, *, root=ROOT):
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--offline", action="store_true", help="validate local files without network access")
    mode.add_argument("--public", action="store_true", help="check public membership and About descriptions, skip administrative settings")
    args = parser.parse_args(argv)
    failed = False
    catalog = None
    declaration = None
    catalog_error = None
    try:
        catalog = read_catalog(root)
    except (OSError, UnicodeError, ValueError, KeyError, TypeError) as error:
        catalog_error = error

    try:
        if catalog is None:
            raise ValueError("cannot validate adoption against an invalid catalog")
        declaration = family_settings.load_declaration(catalog, root)
        print("PASS family adoption declaration")
    except (OSError, UnicodeError, ValueError) as error:
        print("FAIL family adoption declaration: " + " ".join(str(error).splitlines()))
        failed = True

    failed = check_repositories(catalog, catalog_error, offline=args.offline) or failed
    if args.offline or args.public:
        print("SKIP administrative settings (" + ("--offline" if args.offline else "--public") + ")")
        return int(failed)
    if declaration is None:
        print("FAIL administrative settings: cannot compare an invalid declaration")
        return 1
    try:
        findings = family_settings.check_online(declaration, catalog)
    except family_settings.Unavailable as error:
        findings = ["UNKNOWN family standard: " + str(error)]
    except (OSError, UnicodeError, ValueError, KeyError, TypeError) as error:
        print("FAIL administrative settings: " + " ".join(str(error).splitlines()))
        return 1
    for finding in findings:
        print(finding)
    if any(finding.startswith("UNKNOWN ") for finding in findings):
        return 2
    return int(failed or any(finding.startswith("DRIFT ") for finding in findings))


if __name__ == "__main__":
    sys.exit(main())
